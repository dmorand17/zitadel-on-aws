# S3 backend config for the dev environment.
# Usage: terraform init -backend-config=envs/dev/backend.config
#
# The bucket must already exist. S3 native locking (use_lockfile) needs
# Terraform >= 1.10; no DynamoDB table required.
bucket       = "tfstate-654654228593-us-east-1-an"
key          = "zitadel-on-aws/res-sandbox/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
