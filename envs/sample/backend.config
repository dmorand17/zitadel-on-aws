# Sample S3 backend config. Copy envs/sample/ to envs/<env>/ and edit.
# Usage: terraform init -backend-config=envs/<env>/backend.config
#
# The bucket must already exist. S3 native locking (use_lockfile) needs
# Terraform >= 1.10; no DynamoDB table required.
bucket       = "my-terraform-state-bucket"
key          = "zitadel-on-aws/sample/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
