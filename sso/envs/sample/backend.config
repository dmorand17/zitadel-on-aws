# Sample S3 backend config for the stage-2 (SSO) module.
# Copy envs/sample/ to envs/<env>/ and edit.
# Usage: terraform init -backend-config=envs/<env>/backend.config
#
# Use a different key than the stage-1 infra so the two states stay separate.
bucket       = "my-terraform-state-bucket"
key          = "zitadel-on-aws/sample/sso.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
